# ============================================================
# AXIS OBRA — variáveis de ambiente (copie para .env ou configure no Coolify)
# ============================================================

# Porta HTTP do servidor
PORT=3001
NODE_ENV=production

# Segredo usado para assinar as sessões. Use um valor longo e aleatório.
# Se não for definido, o sistema gera um automaticamente em backend/data/.token_secret
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=

# Administrador principal (criado na primeira inicialização se ainda não existir)
ADMIN_EMAIL=cesarsecco@gmail.com
ADMIN_NAME=Cesar Augusto Secco
ADMIN_INITIAL_PASSWORD=123456

# ------------------------------------------------------------
# E-mail (código de acesso e recuperação de senha)
# Sem SMTP_HOST em produção, essas opções ficam ocultas na tela de login.
# Exemplo com Gmail: ative a verificação em 2 etapas e crie uma "Senha de app"
# em https://myaccount.google.com/apppasswords
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-de-16-caracteres
SMTP_FROM=AXIS OBRA <seu-email@gmail.com>

# Opcional: liberar a API para outro domínio (só se o frontend for hospedado separado)
# CORS_ORIGIN=https://app.seudominio.com.br

# Opcional: caminhos de dados (o padrão é backend/data e backend/uploads)
# DATA_DIR=/app/backend/data
# UPLOADS_DIR=/app/backend/uploads
